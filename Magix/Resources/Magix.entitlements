<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Scaffold entitlements. Keep minimal for Developer ID + notarization later.
	     Do NOT enable App Sandbox — CGEventTap + MultitouchSupport need out-of-sandbox access.
	     Harry has a Developer ID cert; wire CODE_SIGN_IDENTITY in Xcode locally (do not invent). -->
